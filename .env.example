# Flask
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false

# Gemini-powered question generation, coding, English feedback, and study help
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional hosted PostgreSQL URL. Leave unset to use local SQLite.
DATABASE_URL=

# Optional SMTP password reset mail
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
